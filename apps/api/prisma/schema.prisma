generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SYSTEM_ADMIN
  COMPANY_ADMIN
  OPERATOR
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum SalesRequestStatus {
  OPEN
  COMPLETED
  CANCELLED
  UNINVOICED
  INVOICED
}

enum ShortageRequestStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum ActivityType {
  SALE_ITEM_ADDED
  SALE_ITEM_EDITED
  SALE_ITEM_DELETED
  SALE_REQUEST_CREATED
  SALE_REQUEST_INVOICED

  SHORTAGE_ITEM_ADDED
  SHORTAGE_QUANTITY_INCREASED
  SHORTAGE_ITEM_EDITED
  SHORTAGE_REQUEST_CREATED
  SHORTAGE_REQUEST_CLOSED

  CUSTOMER_CREATED
  CUSTOMER_UPDATED

  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_IMPORTED

  USER_CREATED
  USER_UPDATED

  BRANCH_CREATED
  BRANCH_UPDATED

  COMPANY_CREATED
  COMPANY_UPDATED
}

model Company {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @db.VarChar(255)
  code      String       @unique @db.VarChar(50)
  logo      String?      @db.Text
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  branches          Branch[]
  users             User[]
  customers         Customer[]
  products          Product[]
  salesRequests     SalesRequest[]
  shortageRequests  ShortageRequest[]
  documentSequences DocumentSequence[]
  activityLogs      ActivityLog[]

  @@map("companies")
}

model Branch {
  id        String       @id @default(uuid()) @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  name      String       @db.VarChar(255)
  code      String       @db.VarChar(50)
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userBranchAccess  UserBranchAccess[]
  salesRequests     SalesRequest[]
  shortageRequests  ShortageRequest[]
  documentSequences DocumentSequence[]
  activityLogs      ActivityLog[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("branches")
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  companyId    String?      @map("company_id") @db.Uuid
  fullName     String       @map("full_name") @db.VarChar(255)
  username     String       @unique @db.VarChar(100)
  passwordHash String       @map("password_hash") @db.VarChar(255)
  role         UserRole
  status       EntityStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  company            Company?             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userBranchAccess   UserBranchAccess[]
  createdSalesItems        SalesItem[]          @relation("SalesItemCreatedBy")
  invoicedSales            SalesRequest[]       @relation("SalesRequestInvoicedBy")
  createdSalesRequests     SalesRequest[]       @relation("SalesRequestCreatedBy")
  createdCustomers         Customer[]           @relation("CustomerCreatedBy")
  createdShortages         ShortageItem[]       @relation("ShortageItemCreatedBy")
  createdShortageRequests  ShortageRequest[]    @relation("ShortageRequestCreatedBy")
  closedShortages          ShortageRequest[]    @relation("ShortageRequestClosedBy")
  shortageEvents           ShortageItemEvent[]  @relation("ShortageEventUser")
  activityLogs             ActivityLog[]

  @@index([companyId])
  @@map("users")
}

model Customer {
  id             String       @id @default(uuid()) @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  name           String       @db.VarChar(255)
  normalizedName String       @map("normalized_name") @db.VarChar(255)
  phone          String?      @db.VarChar(50)
  taxNumber      String?      @map("tax_number") @db.VarChar(50)
  city           String?      @db.VarChar(100)
  createdById    String?      @map("created_by_id") @db.Uuid
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy User?          @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  sales     SalesRequest[]

  @@unique([companyId, normalizedName])
  @@index([companyId, active])
  @@index([companyId, normalizedName])
  @@map("customers")
}

model UserBranchAccess {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
  @@map("user_branch_access")
}

model Product {
  id                   String       @id @default(uuid()) @db.Uuid
  companyId            String       @map("company_id") @db.Uuid
  partNumber           String       @map("part_number") @db.VarChar(100)
  partNumberNormalized String       @map("part_number_normalized") @db.VarChar(100)
  partName             String       @map("part_name") @db.VarChar(255)
  brand                String       @db.VarChar(100)
  brandNormalized      String       @map("brand_normalized") @db.VarChar(100)
  status               EntityStatus @default(ACTIVE)
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  company            Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  salesItems         SalesItem[]
  shortageItems      ShortageItem[]
  alternativeNumbers ProductAlternativeNumber[]

  @@unique([companyId, partNumberNormalized, brandNormalized])
  @@index([companyId, partNumberNormalized])
  @@index([companyId, status])
  @@map("products")
}

model ProductAlternativeNumber {
  id               String   @id @default(uuid()) @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  number           String   @db.VarChar(100)
  normalizedNumber String   @map("normalized_number") @db.VarChar(100)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, normalizedNumber])
  @@index([normalizedNumber])
  @@map("product_alternative_numbers")
}

model DocumentSequence {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  type       String   @db.VarChar(20) // SALES, SHORTAGE
  prefix     String   @db.VarChar(10) // SL, SH
  dateKey    String   @map("date_key") @db.VarChar(10) // YYYYMMDD
  lastNumber Int      @default(0) @map("last_number")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([companyId, branchId, type, dateKey])
  @@index([companyId, branchId])
  @@map("document_sequences")
}

model SalesRequest {
  id                    String             @id @default(uuid()) @db.Uuid
  companyId             String             @map("company_id") @db.Uuid
  branchId              String             @map("branch_id") @db.Uuid
  customerId            String?            @map("customer_id") @db.Uuid
  createdById           String?            @map("created_by_id") @db.Uuid
  documentNumber        String             @unique @map("document_number") @db.VarChar(50)
  businessDate          DateTime           @map("business_date") @db.Date
  status                SalesRequestStatus @default(OPEN)
  totalItems            Int                @default(0) @map("total_items")
  totalQuantity         Decimal            @default(0) @map("total_quantity") @db.Decimal(12, 2)
  totalAmount           Decimal            @default(0) @map("total_amount") @db.Decimal(12, 2)
  officialInvoiceNumber String?            @map("official_invoice_number") @db.VarChar(100)
  officialInvoiceDate   DateTime?          @map("official_invoice_date") @db.Date
  invoicedByUserId      String?            @map("invoiced_by_user_id") @db.Uuid
  invoicedAt            DateTime?          @map("invoiced_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation("SalesRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  invoicedBy User?       @relation("SalesRequestInvoicedBy", fields: [invoicedByUserId], references: [id], onDelete: SetNull)
  items      SalesItem[]

  @@index([companyId, branchId, status])
  @@index([companyId, customerId])
  @@index([documentNumber])
  @@index([officialInvoiceNumber])
  @@index([createdAt])
  @@map("sales_requests")
}

model SalesItem {
  id                 String   @id @default(uuid()) @db.Uuid
  salesRequestId     String   @map("sales_request_id") @db.Uuid
  productId          String?  @map("product_id") @db.Uuid
  partNumberSnapshot String   @map("part_number_snapshot") @db.VarChar(100)
  partNameSnapshot   String   @map("part_name_snapshot") @db.VarChar(255)
  brandSnapshot      String   @map("brand_snapshot") @db.VarChar(100)
  quantity           Decimal  @db.Decimal(12, 2)
  unitPrice          Decimal  @map("unit_price") @db.Decimal(12, 2)
  lineTotal          Decimal? @map("line_total") @db.Decimal(12, 2)
  soldTo             String   @map("sold_to") @db.VarChar(255)
  note               String?  @db.Text
  createdByUserId    String   @map("created_by_user_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  salesRequest SalesRequest @relation(fields: [salesRequestId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("SalesItemCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([salesRequestId])
  @@index([createdByUserId])
  @@index([partNumberSnapshot])
  @@map("sales_items")
}

model ShortageRequest {
  id             String                @id @default(uuid()) @db.Uuid
  companyId      String                @map("company_id") @db.Uuid
  branchId       String                @map("branch_id") @db.Uuid
  createdById    String?               @map("created_by_id") @db.Uuid
  documentNumber String                @unique @map("document_number") @db.VarChar(50)
  businessDate   DateTime              @map("business_date") @db.Date
  status         ShortageRequestStatus @default(OPEN)
  totalItems     Int                   @default(0) @map("total_items")
  totalQuantity  Decimal               @default(0) @map("total_quantity") @db.Decimal(12, 2)
  closedByUserId String?               @map("closed_by_user_id") @db.Uuid
  closedAt       DateTime?             @map("closed_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy User?          @relation("ShortageRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  closedBy  User?          @relation("ShortageRequestClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  items     ShortageItem[]

  @@index([companyId, branchId, status])
  @@index([documentNumber])
  @@index([createdAt])
  @@map("shortage_requests")
}

model ShortageItem {
  id                 String   @id @default(uuid()) @db.Uuid
  shortageRequestId  String   @map("shortage_request_id") @db.Uuid
  productId          String?  @map("product_id") @db.Uuid
  partNumberSnapshot String   @map("part_number_snapshot") @db.VarChar(100)
  partNameSnapshot   String   @map("part_name_snapshot") @db.VarChar(255)
  brandSnapshot      String   @map("brand_snapshot") @db.VarChar(100)
  quantity           Decimal  @db.Decimal(12, 2)
  priority           String?  @db.VarChar(50)
  note               String?  @db.Text
  createdByUserId    String   @map("created_by_user_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  shortageRequest ShortageRequest     @relation(fields: [shortageRequestId], references: [id], onDelete: Cascade)
  product         Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdBy       User                @relation("ShortageItemCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  events          ShortageItemEvent[]

  @@unique([shortageRequestId, partNumberSnapshot, brandSnapshot])
  @@index([shortageRequestId])
  @@index([createdByUserId])
  @@index([partNumberSnapshot])
  @@map("shortage_items")
}

model ShortageItemEvent {
  id               String   @id @default(uuid()) @db.Uuid
  shortageItemId   String   @map("shortage_item_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  previousQuantity Decimal  @map("previous_quantity") @db.Decimal(12, 2)
  addedQuantity    Decimal  @map("added_quantity") @db.Decimal(12, 2)
  newQuantity      Decimal  @map("new_quantity") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  shortageItem ShortageItem @relation(fields: [shortageItemId], references: [id], onDelete: Cascade)
  user         User         @relation("ShortageEventUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([shortageItemId])
  @@index([userId])
  @@map("shortage_item_events")
}

model ActivityLog {
  id              String       @id @default(uuid()) @db.Uuid
  companyId       String       @map("company_id") @db.Uuid
  branchId        String?      @map("branch_id") @db.Uuid
  type            ActivityType
  referenceNumber String?      @map("reference_number") @db.VarChar(50)
  description     String       @db.Text
  userId          String       @map("user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([companyId, branchId])
  @@index([type])
  @@map("activity_logs")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String?  @map("company_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(100)
  resource  String   @db.VarChar(100)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  details   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}
